# Run Control dispatcher service environment
# Copy to .env.run-control-dispatcher and fill secrets locally (never commit).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

RUN_CONTROL_DISPATCHER_ENABLED=true
RUN_CONTROL_DISPATCHER_HEALTH_ONLY=false
RUN_CONTROL_DISPATCHER_LAUNCH_ENABLED=true
RUN_CONTROL_DISPATCHER_WORKER_ID=run-dispatcher:your-worker-host
RUN_CONTROL_DISPATCHER_ALLOWED_RUN_TYPES=account_session,outreach_session,login_provisioning,login_email_code_resume
RUN_CONTROL_DISPATCHER_HEARTBEAT_SECONDS=20
RUN_CONTROL_DISPATCHER_POLL_SECONDS=5
RUN_CONTROL_DISPATCHER_MAX_CONSECUTIVE_LOOP_ERRORS=5
RUNTIME_HEARTBEATS_ENABLED=true

# Supabase REST client resilience (shared by dispatcher preflight/heartbeat).
# SUPABASE_REST_TIMEOUT_SECONDS=15
# SUPABASE_REST_MAX_RETRIES=2
# SUPABASE_REST_RETRY_BACKOFF_SECONDS=0.75
# RUN_CONTROL_DISPATCHER_PREFLIGHT_RETRIES=3
# RUN_CONTROL_DISPATCHER_PREFLIGHT_RETRY_SECONDS=2

# Safe-start: refuse launch mode when active queue exists unless explicitly overridden.
# RUN_CONTROL_DISPATCHER_ALLOW_EXISTING_QUEUE=false
