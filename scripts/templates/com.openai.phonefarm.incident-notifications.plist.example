<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openai.phonefarm.incident-notifications</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <string>cd /Users/admin/instagram-worker-python &amp;&amp; python3 scripts/dispatch_incident_notifications.py</string>
  </array>

  <key>StartInterval</key>
  <integer>120</integer>

  <key>WorkingDirectory</key>
  <string>/Users/admin/instagram-worker-python</string>

  <key>StandardOutPath</key>
  <string>/Users/admin/instagram-worker-python/logs/incident_notifications_dispatcher.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/admin/instagram-worker-python/logs/incident_notifications_dispatcher.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
