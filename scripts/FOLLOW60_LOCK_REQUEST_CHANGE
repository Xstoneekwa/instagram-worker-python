#!/usr/bin/env python3
"""Create unsigned initial, final, or legacy Follow60 approval payloads."""

from __future__ import annotations

import argparse
from datetime import datetime, timedelta, timezone
import json
from pathlib import Path
import subprocess
import sys
import uuid

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from follow60_lock_v3 import sha256_bytes  # noqa: E402


def _write(output: str, payload: dict) -> None:
    Path(output).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload, sort_keys=True))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", choices=("legacy", "initial", "final"), default="legacy")
    parser.add_argument("--base-revision", default="HEAD")
    parser.add_argument("--requested-scope", default="")
    parser.add_argument("--output", required=True)
    parser.add_argument("--expiry-minutes", type=int, default=60)
    parser.add_argument("--change-id", default="")
    parser.add_argument("--base-manifest", default=str(ROOT / "docs/governance/FOLLOW60_MAINLINE_LOCK_V3.json"))
    parser.add_argument("--authorized-path", action="append", default=[])
    parser.add_argument("--dependency-scope", action="append", default=[])
    parser.add_argument("--freeze")
    args = parser.parse_args()

    if args.mode == "final":
        if not args.freeze:
            raise SystemExit("freeze_required")
        freeze = json.loads(Path(args.freeze).read_text(encoding="utf-8"))
        payload = {
            "schema": "FOLLOW60_FINAL_APPROVAL_V1",
            "change_id": freeze["change_id"],
            "base_sha": freeze["base_sha"],
            "final_diff_hash": freeze["final_diff_hash"],
            "final_manifest_hash": freeze["final_manifest_hash"],
            "final_protected_scope_hash": freeze["final_protected_scope_hash"],
        }
        _write(args.output, payload)
        return 0

    base_sha = subprocess.check_output(
        ["git", "-C", str(ROOT), "rev-parse", args.base_revision], text=True
    ).strip()
    now = datetime.now(timezone.utc)
    change_id = args.change_id or str(uuid.uuid4())
    if args.mode == "initial":
        if not args.authorized_path or not args.dependency_scope:
            raise SystemExit("authorized_path_and_dependency_scope_required")
        payload = {
            "schema": "FOLLOW60_CHANGE_AUTHORIZATION_REQUEST_V1",
            "approval_status": "PENDING_LIAM_SIGNATURE_1",
            "change_id": change_id,
            "base_sha": base_sha,
            "authorized_paths": sorted(set(args.authorized_path)),
            "authorized_dependency_scope": sorted(set(args.dependency_scope)),
            "issued_at": now.isoformat(),
            "expires_at": (now + timedelta(minutes=max(1, args.expiry_minutes))).isoformat(),
            "nonce": change_id,
            "one_task_only": True,
            "permits_intermediate_edits_within_scope": True,
            "permits_final_promotion": False,
            "permits_runtime_activation": False,
        }
        _write(args.output, payload)
        return 0

    head_sha = subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
    diff = subprocess.check_output(["git", "-C", str(ROOT), "diff", "--binary", f"{base_sha}..{head_sha}"])
    files = subprocess.check_output(["git", "-C", str(ROOT), "diff", "--name-only", f"{base_sha}..{head_sha}"], text=True).splitlines()
    payload = {
        "schema": "FOLLOW60_LOCK_CHANGE_REQUEST_V1",
        "change_id": change_id,
        "base_sha": base_sha,
        "head_sha": head_sha,
        "base_manifest_sha256": sha256_bytes(Path(args.base_manifest).read_bytes()),
        "files_requested": sorted(set(files)),
        "diff_sha256": sha256_bytes(diff),
        "requested_scope": str(args.requested_scope),
        "requested_at": now.isoformat(),
        "expires_at": (now + timedelta(minutes=max(1, args.expiry_minutes))).isoformat(),
        "approval_status": "REQUESTED_NOT_APPROVED",
    }
    _write(args.output, payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
