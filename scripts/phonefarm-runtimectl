#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ ! -f "$ROOT_DIR/phonefarm_runtime_control.py" ]]; then
  ROOT_DIR="${PHONEFARM_RUNTIME_CURRENT_LINK:-/Users/admin/phonefarm-worker-current}"
fi
exec "${PYTHON:-python3}" "$ROOT_DIR/phonefarm_runtime_control.py" "$@"
