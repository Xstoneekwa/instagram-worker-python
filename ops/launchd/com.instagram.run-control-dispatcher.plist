<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.instagram.run-control-dispatcher</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>/Users/admin/instagram-worker-python/scripts/run_control_dispatcher_service.sh start</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/admin/instagram-worker-python</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>RUN_CONTROL_DISPATCHER_ENV_FILE</key>
      <string>/Users/admin/instagram-worker-python/.env.run-control-dispatcher</string>
      <key>RUN_CONTROL_DISPATCHER_LOG_DIR</key>
      <string>/Users/admin/instagram-worker-python/logs/run-control-dispatcher</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/admin/instagram-worker-python/logs/run-control-dispatcher/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/instagram-worker-python/logs/run-control-dispatcher/launchd.stderr.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
  </dict>
</plist>
