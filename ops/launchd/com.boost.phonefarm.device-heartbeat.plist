<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.boost.phonefarm.device-heartbeat</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>/Users/admin/instagram-worker-python/scripts/device_heartbeat_service.sh start</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/admin/instagram-worker-python</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>DEVICE_HEARTBEAT_ENV_FILE</key>
      <string>/Users/admin/instagram-worker-python/.env</string>
      <key>DEVICE_HEARTBEAT_LOG_DIR</key>
      <string>/Users/admin/instagram-worker-python/logs/device-heartbeat-service</string>
      <key>DEVICE_HEARTBEAT_INTERVAL_SECONDS</key>
      <string>60</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/admin/instagram-worker-python/logs/device-heartbeat-service/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/instagram-worker-python/logs/device-heartbeat-service/launchd.stderr.log</string>
    <key>ThrottleInterval</key>
    <integer>15</integer>
  </dict>
</plist>
